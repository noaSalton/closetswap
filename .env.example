# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-only, NEVER exposed to the client.
# Used only inside server actions for admin operations (block/unblock users, stats).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
